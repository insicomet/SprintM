{
  "name": "sprintm",
  "version": "0.1.0",
  "description": "Калькулятор ангаров ИНСИ «Спринт М» — расчёт сечений, ведомость материалов, стоимость",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
